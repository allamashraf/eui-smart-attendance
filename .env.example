# Copy to .env.local; never commit real secrets.
# Create a free PostgreSQL database locally or on Supabase.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/eui_attendance"
# Generate both with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="REPLACE_WITH_RANDOM_64_HEX_CHARACTERS"
QR_SECRET="REPLACE_WITH_DIFFERENT_RANDOM_64_HEX_CHARACTERS"

# Optional settings. Leave them out to use the defaults shown here.
# How often the QR code changes, in seconds (allowed 5-30).
QR_INTERVAL_SECONDS=8
# Extra seconds a code still works after it changes, for slow phones (allowed 0-10).
QR_GRACE_SECONDS=3
